# Development server port.
PORT=4400

# Public origin used to generate hosted payment URLs returned from bill creation.
SIMULATOR_PUBLIC_URL=http://127.0.0.1:4400

# Local Basic Auth username. This must match Laravel's BILPLZ_API_KEY.
BILLPLZ_API_KEY=local-api-key

# Local callback/redirect signing key. This must match Laravel's BILPLZ_X_SIGNATURE.
BILLPLZ_X_SIGNATURE_KEY=local-signature-key

# Timeout, in milliseconds, used for normal callback delivery.
CALLBACK_TIMEOUT_MS=5000

# Storage is in memory and resets whenever the simulator restarts.
# Never place real Billplz Production credentials in this file.
