# Local Billplz simulator testing only.
# Copy these entries into your local .env; never use these credentials in Production.
# After changing .env, run: php artisan optimize:clear
# Verify the resolved services.billplz configuration before testing.
# The Production Billplz URL and credentials must remain unchanged outside local development.

APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

FRONTEND_URL_ECOMMERCE=http://127.0.0.1:3000
FRONTEND_URL_BOOKING=http://127.0.0.1:3001

BILPLZ_API_KEY=local-api-key
BILPLZ_COLLECTION_ID=local-collection
BILPLZ_X_SIGNATURE=local-signature-key
BILPLZ_BASE_URL=http://127.0.0.1:4400/api/v3

# Docker alternative when Laravel runs in Docker and the simulator runs on the host:
# BILPLZ_BASE_URL=http://host.docker.internal:4400/api/v3

# Payment gateway records in the local database can override the environment values above.
# If configured, set both ecommerce and booking Billplz gateway records to:
# Base URL:       http://127.0.0.1:4400/api/v3
# API key:        local-api-key
# Collection ID:  local-collection
# X-signature key: local-signature-key
